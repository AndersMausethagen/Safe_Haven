    item: {fileID: 11400000, guid: d4d2a84b7c6083a4dba750243db7aae9, type: 2}
    amount: 6
    line: '{name} burned a clamp of charcoal while the forge was quiet.'
    weight: 1
  - job: {fileID: 11400000, guid: f4c65068c1237a04b8a587a274672012, type: 2}
    item: {fileID: 11400000, guid: d0c7b274979b4ad46a9f3bf89b8cfa64, type: 2}
    amount: 1
    line: '{name} brewed one draught more than the order asked, and put it by for you.'
