    costAmount: 1
  - placeId: haven.ruined_watchtower.0
    name: The watch's last tally
    verb: Read
    item: {fileID: 0}
    amount: 1
    taken: 'Scratched into the stone by the door: seven strokes, a wolf''s head, then nothing.'
    offset: {x: 4, y: 2}
    marker: {fileID: 6205942061878126552, guid: 1d47d031ba81f524784f8df59c15347c, type: 3}
