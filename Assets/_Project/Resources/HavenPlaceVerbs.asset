  - placeId: haven.burnt_farmstead.0
    name: Seed from Asa's field
    verb: Take
    item: {fileID: 11400000, guid: 17b016991a7aa4846a121d6027443bf2, type: 2}
    amount: 1
    taken: Asa's field gives back the family's seed. More in a few days.
    offset: {x: -12, y: 2.5}
    marker: {fileID: 0}
    markerScale: 1
    markerTurn: 0
    questTarget: {fileID: 0}
