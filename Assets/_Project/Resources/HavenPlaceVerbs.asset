    when: 0
  - placeId: haven.fisher_s_rest.0
    name: The fishers' old nets
    verb: Take
    item: {fileID: 11400000, guid: 4df650debd4ce21459e04a0c92ffa207, type: 2}
    amount: 2
    taken: Rotten mostly. The weights are good, and the cord will twist into something.
    offset: {x: -5.5, y: 2}
    marker: {fileID: 0}
    markerScale: 1
