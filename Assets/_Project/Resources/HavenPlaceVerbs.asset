    costAmount: 1
  - placeId: haven.authored.tarn_shrine
    name: The tarn's memory
    verb: Look into the tarn
    item: {fileID: 0}
    amount: 1
    taken: A man in grey at this shrine, a hundred winters gone, with a lantern and no fire behind him. The winter's mist had taken his wife and child, and he asked the tarn for a door to them. It gave him the wrong one. The hunger came through, and the hearth below went cold. He is looking still.
    offset: {x: 0, y: -3}
    marker: {fileID: 7115005062286561332, guid: 8ea1636a9e145c14daea56dafda6919e, type: 3}
    markerScale: 0.7
    markerTurn: 20
    questTarget: {fileID: 11400000, guid: caba935f36654ea47a5fc92297900f61, type: 2}
    gate: 1
    quest: {fileID: 11400000, guid: 1367dde89e95d714bbac19728a1bc16e, type: 2}
    everyDays: 0
    keepsSpans: 3
    when: 2
    costItem: {fileID: 0}
    costAmount: 1
  - placeId: haven.old_barrow.0
    name: The barrow stone
    verb: Cut their marks
    item: {fileID: 0}
    amount: 1
    taken: 'No names: the tarn never gave them. A small horse, and a bear beside it, the way she would have drawn him.'
    offset: {x: 4, y: 0}
    marker: {fileID: 1987186056636952893, guid: 9c63895aedf974b41ac19d55902cc357, type: 3}
    markerScale: 0.8
    markerTurn: 20
    questTarget: {fileID: 11400000, guid: e2ef7ef98b2a29440866992415d91f45, type: 2}
