    costAmount: 1
  - placeId: haven.burnt_farmstead.0
    name: A dropped pail
    verb: Look
    item: {fileID: 0}
    amount: 1
    taken: A pail from the farm, dropped where the fence runs out, a child's sling still knotted to its handle. They went this way.
    offset: {x: 27, y: -7.5}
    marker: {fileID: 6636398860116550178, guid: 51ca6153c8697d84398f230f8cb78295, type: 3}
