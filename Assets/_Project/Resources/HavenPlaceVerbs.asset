  - placeId: haven.burnt_farmstead.0
    name: A child's sling
    verb: Take
    item: {fileID: 11400000, guid: 4df650debd4ce21459e04a0c92ffa207, type: 2}
    amount: 1
    taken: A child's sling of nettle cord, dropped where the fence runs out. They went this way.
    offset: {x: 27, y: -7.5}
    marker: {fileID: 0}
    markerScale: 1
    markerTurn: 0
