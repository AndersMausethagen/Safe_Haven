      worker: {fileID: 0}
      workHours: {x: 14, y: 18}
      workAt: {x: 1.5, y: -1.5}
    - note: 'The family found: the grave tended.'
      gate: 2
      quest: {fileID: 11400000, guid: c02abb0f34687e841b484a01d52b7be5, type: 2}
      dressing: {fileID: 0}
      offset: {x: 0, y: 0}
      turn: 0
      thoughts:
      - Whoever they were, they're remembered now. That was the point of the fire.
      smokeRise: 0
