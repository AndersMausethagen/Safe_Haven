          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>I remember this. A fire beside my stones, and someone to keep it.</i>
        afterFightPause: 0
        aside: 1
    - rid: 2623126018147484437
      type: {class: WhenUsed, ns: , asm: SafeHaven}
