    - rid: 2623126038171615457
      type: {class: WaitNode, ns: , asm: SafeHaven}
      data:
        id: 5d703e7083204320a8d9a636a1ed33ca
        position: {x: 340, y: 60}
        seconds: 2
    - rid: 2623126038171615458
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 3ce69f796d9141f887b81ebd4780db33
        position: {x: 640, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Lay the thread on my stone. Closer. Now, all of you, a hand near the fire.</i>
        afterFightPause: 1
        aside: 0
    - rid: 2623126038171615459
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 99d705fb136a4b3dbe41e9262f7f3cd9
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>There. A window, no wider than a book. A low room, a scarred table, a young woman with a needle between her lips, and a boy kicking at her knee.</i>
        afterFightPause: 1
        aside: 0
    - rid: 2623126268168110208
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: daa3095b088244188902613eb9764dad
        position: {x: 1180, y: 60}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Sigrun.
        afterFightPause: 1
        aside: 0
    - rid: 2623126268168110209
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: a9e03e4963994fb88d82961a386a0382
        position: {x: 1420, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>She looked up. She heard something. Take the thread away, little one, before what is behind me hears it too.</i>
        afterFightPause: 1
        aside: 0
    - rid: 2623126268168110210
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: a6ae257135bd4eb8a08826e8f2b4eae8
        position: {x: 1660, y: 60}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: She's alive.
        afterFightPause: 1
        aside: 0
    - rid: 2623126268168110211
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 957e105df850418db5a82766efa48997
        position: {x: 1900, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Somewhere.</i>
        afterFightPause: 1
        aside: 0
    - rid: 2623126268168110212
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 3e567f6a759640d1be64c2856068df62
        position: {x: 2140, y: 60}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Somewhere is enough for now. Thank you.
        afterFightPause: 1
        aside: 0
