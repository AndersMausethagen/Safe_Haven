    to: 2c2daaa15b7e42e1939018e0af552b73
  - from: 2c2daaa15b7e42e1939018e0af552b73
    output: 0
    to: ed02f3fab0d94a83a83c4972033faf9c
  - from: ed02f3fab0d94a83a83c4972033faf9c
    output: 0
    to: b1461d8af2a948539e0196e681659847
  - from: b1461d8af2a948539e0196e681659847
    output: 0
    to: d943681d6c1d4d33a08acb7b4e0eaca2
  logSteps: 0
  references:
    version: 2
    RefIds:
    - rid: 287758281410609324
      type: {class: WhenQuestEvent, ns: , asm: SafeHaven}
      data:
        id: db744f88bd8f4135b93d047a711f0fe6
        position: {x: 40, y: 60}
        once: 1
        questEvent: {fileID: 11400000, guid: 3795709c84a5d1f4fa37ecf3e7b170a1, type: 2}
    - rid: 287758281410609325
      type: {class: ChoiceNode, ns: , asm: SafeHaven}
      data:
        id: b3a129720b6440e1aafc7d1de6ec2b48
        position: {x: 340, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: Warmth stirs in the old stone. <i>Little one. You fell out of the dark with the whole forest at your heels, and I caught you. I could only catch one.</i>
        answers:
        - Where are the others?
        - What are you?
        mustAnswer: 1
        afterFightPause: 1
    - rid: 287758281410609326
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 520bc1e54e6c45278d500f0130eda22c
        position: {x: 640, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Seven sparks, scattered through the Misty Woods. They are alive. I hear them when the wind is right. But the forest does not kill the lost, little one. It forgets them.</i>
        afterFightPause: 1
        aside: 0
    - rid: 287758281410609327
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: f986bfdcd88e43e691cd92a74cf3c825
        position: {x: 640, y: 230}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>The last of an old promise. I keep the dark from this clearing. But that is not what you need to know.</i>
        afterFightPause: 1
        aside: 0
    - rid: 287758281410609328
      type: {class: ChoiceNode, ns: , asm: SafeHaven}
      data:
        id: bfb8ec03f1094bd889485b268a86768f
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>First the way home. Then their names. Then there is no one left to find.</i>
        answers:
        - How do I reach them?
        - Open the way. I'll go now.
        mustAnswer: 1
        afterFightPause: 1
    - rid: 287758281410609329
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 2c2daaa15b7e42e1939018e0af552b73
        position: {x: 1240, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>I am a door, little one, and I have gone to sleep. I am too thin to wake myself. Long ago people kept a hearth beside these stones, and I kept the night from their door. That was the pact. No fire has burned here in a hundred winters.</i>
        afterFightPause: 1
        aside: 0
    - rid: 287758281410609330
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: eba4980314b94677ad41dc28996f6592
        position: {x: 1240, y: 230}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>With what? You have nothing but your hands, and I cannot open.</i>
        afterFightPause: 1
        aside: 0
    - rid: 287758281410609331
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: ed02f3fab0d94a83a83c4972033faf9c
        position: {x: 1540, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>So light one. The forest cannot forget a hearth that someone tends. It will feed my ward, and out in the mist your people will see it and know which way is home.</i>
        afterFightPause: 1
        aside: 0
    - rid: 287758281410609332
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: b1461d8af2a948539e0196e681659847
        position: {x: 1840, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>A fire first. Then a home worth coming back to. Then we go and fetch them. And one day, little one, you will tell me why these old stones woke for your hand.</i>
        afterFightPause: 1
        aside: 0
    - rid: 2623125951272714349
      type: {class: CountAsDoneNode, ns: , asm: SafeHaven}
      data:
        id: d943681d6c1d4d33a08acb7b4e0eaca2
