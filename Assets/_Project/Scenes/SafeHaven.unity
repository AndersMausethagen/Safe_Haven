        id: b90196489b2544d9af142779ca1c4fd2
        position: {x: 340, y: 400}
        seconds: 0.8
    - rid: 2623126018147484439
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: ac06ae723cb64e7f935f6b87d129f31f
        position: {x: 340, y: 570}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>And this. Their door, and the night kept from it, for as long as the fire burned.</i>
        afterFightPause: 0
        aside: 1
    - rid: 2623126018147484440
      type: {class: WhenUsed, ns: , asm: SafeHaven}
