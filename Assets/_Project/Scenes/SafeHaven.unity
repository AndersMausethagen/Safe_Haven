  logSteps: 0
  references:
    version: 2
    RefIds:
    - rid: 287758281410609307
      type: {class: WhenQuest, ns: , asm: SafeHaven}
      data:
        id: 477f9d0ea524455da2fcd0d99fbb8690
        position: {x: 40, y: 60}
