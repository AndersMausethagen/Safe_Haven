        revealRadius: 14
    - rid: 287758281410609315
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: be9dadacc0e84d43bde9b929736f5e43
        position: {x: 640, y: 230}
        speaker:
          player: 0
          name: Sigrid
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: <i>...can anyone hear... Ingrid was right behind me when the stones broke. She's hurt. Find her first. Do you hear me? Find her first...</i>
        afterFightPause: 1
        aside: 0
    - rid: 287758281410609316
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 99d53a1421624c4ba0d269ce56d83503
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>My stones have gone quiet, but she is right. One spark burns close, just beyond me, hiding from the wolves. Make yourself tools, and go.</i>
        afterFightPause: 1
        aside: 0
