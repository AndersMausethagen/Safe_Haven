  - from: f37791924e70461881987afa66d0410e
    output: 0
    to: 16009188fe274db7a7d55ee9e24a0a7e
  logSteps: 0
  references:
    version: 2
    RefIds:
    - rid: 2623126018147484424
      type: {class: WhenQuest, ns: , asm: SafeHaven}
      data:
        id: cf79ad2456e6400898eceb29c774ce58
        position: {x: 40, y: 60}
