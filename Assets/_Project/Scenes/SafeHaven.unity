        position: {x: 340, y: 740}
        seconds: 0.8
    - rid: 2623126018147484442
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: df29e32128714af98cf7410b8a5eda1d
        position: {x: 340, y: 910}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>And the guardian under the roots, who kept the forest's half. Where is it now?</i>
        afterFightPause: 0
        aside: 1
