        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Hold a ring of them round me, little one, and the forest will remember us for good.</i>
        afterFightPause: 0
        aside: 1
