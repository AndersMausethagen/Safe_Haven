          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>There. A hearth beside my stones, after a hundred winters.</i>
        afterFightPause: 1
        aside: 0
    - rid: 287758281410609322
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 48788c835e724521b03c36a4cccaa14f
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Do you feel that? The ward has remembered what it is for. And far out in the mist, little one, someone has stopped walking and turned to look.</i>
        afterFightPause: 1
        aside: 0
