      data:
        id: c0f48ac2fe1b4bc3a4986fe8d9972599
        position: {x: 640, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Secure. Feel how still it is out there now. A land held that firmly sends home what it grows at every dawn, and the night's bands will not come through it.</i>
        afterFightPause: 0
        aside: 1
    - rid: 2623126038171615452
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
