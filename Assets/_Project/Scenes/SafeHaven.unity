          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: '<i>Little one. My stones are loose where the roots were. Steady them, and I can open a wider way: deeper woods, and better things in them.</i>'
