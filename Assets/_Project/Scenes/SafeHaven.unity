          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Each holds a little of what I was. Free their orbs when you pass them, and I will hold the door a little longer.</i>
        afterFightPause: 0
        aside: 1
