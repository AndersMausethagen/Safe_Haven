  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7585b9b1e2e24704186225f4b6f8d69a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SafeHaven::StoryScript
  nodes:
  - rid: 2623126038171615456
  - rid: 2623126038171615457
  - rid: 2623126038171615458
  - rid: 2623126038171615459
  - rid: 2623126268168110213
  - rid: 2623126268168110214
  links:
  - from: 02b464dcce6f46d7b447e80c6adb5a49
    output: 0
    to: 09b15ac5f7d8468b9cf3ab563cc5672e
  - from: 09b15ac5f7d8468b9cf3ab563cc5672e
    output: 0
    to: 386e2d9b51ac46f69e1162cd5c6d9ecd
  - from: 386e2d9b51ac46f69e1162cd5c6d9ecd
    output: 0
    to: c2e901849350495b9886394952ccc286
  - from: c2e901849350495b9886394952ccc286
    output: 0
    to: c3a96d8a6efe45258410b9b65ba2ab22
  - from: c3a96d8a6efe45258410b9b65ba2ab22
    output: 0
    to: 793d94e218c249f4b61615166e75beba
  logSteps: 0
  references:
    version: 2
    RefIds:
    - rid: 2623126038171615456
      type: {class: WhenQuest, ns: , asm: SafeHaven}
      data:
        id: 02b464dcce6f46d7b447e80c6adb5a49
        position: {x: 40, y: 60}
        once: 1
        quest: {fileID: 11400000, guid: 28512bedb6de9f9498b9b3836107c1e9, type: 2}
        when: 1
        alsoAfterLoading: 0
    - rid: 2623126038171615457
      type: {class: WaitNode, ns: , asm: SafeHaven}
      data:
        id: 09b15ac5f7d8468b9cf3ab563cc5672e
        position: {x: 340, y: 60}
        seconds: 2
    - rid: 2623126038171615458
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 386e2d9b51ac46f69e1162cd5c6d9ecd
        position: {x: 640, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: '<i>You stood at his door. I felt it through the snow: a door that is not mine, and a man who has worn a hole in the world with knocking.</i>'
        afterFightPause: 1
        aside: 0
    - rid: 2623126038171615459
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: c2e901849350495b9886394952ccc286
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>He is looking for two people the winter took. He opens doors to find them, and the wrong ones let things out.</i>
        afterFightPause: 1
        aside: 0
    - rid: 2623126268168110213
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: c3a96d8a6efe45258410b9b65ba2ab22
        position: {x: 1180, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: '<i>It called him by his name. That is how you know it lies: the ones he is looking for never used it.</i>'
        afterFightPause: 1
        aside: 0
    - rid: 2623126268168110214
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 793d94e218c249f4b61615166e75beba
        position: {x: 1420, y: 60}
        speaker:
          player: 0
          name: The Portal
          model: {fileID: 0}
          portrait: {fileID: 0}
          voice: {fileID: 11400000, guid: 8aef6fe04075b604a8ffeaaef324344f, type: 2}
          voiceFrom: {fileID: 1038728947}
        line: <i>Keep your own names close. Whatever is behind those doors has learned to speak in borrowed voices.</i>
        afterFightPause: 1
        aside: 0
