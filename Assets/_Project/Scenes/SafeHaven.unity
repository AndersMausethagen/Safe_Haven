  nodes:
  - rid: 2623126018147484424
  - rid: 2623126018147484425
  - rid: 2623126018147484426
  - rid: 2623126018147484427
  links:
  - from: cf79ad2456e6400898eceb29c774ce58
    output: 0
    to: 627097a6dfe649f09f3e9830c2056252
  - from: 627097a6dfe649f09f3e9830c2056252
