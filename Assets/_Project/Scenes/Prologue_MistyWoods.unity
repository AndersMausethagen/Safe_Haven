        position: {x: 2440, y: 1590}
        reaches: 0.42
    - rid: 2623126109533504172
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 5dc87f02591549dfaf6bc4d8a172615f
        position: {x: 2740, y: 1420}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 810501267}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Sigrid. The sun is going down. It was morning.
        afterFightPause: 0
        aside: 1
    - rid: 2623126109533504173
      type: {class: WaitForWalkNode, ns: , asm: SafeHaven}
      data:
        id: 295a795023f146688827cb8f891936d9
        position: {x: 2440, y: 1760}
        reaches: 0.7
    - rid: 2623126109533504174
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 95f25e9c8e5d4c3fb4b80bb1c24d693c
        position: {x: 2740, y: 1590}
        speaker:
          player: 0
          name: Runa
          model: {fileID: 334759803}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: No birds. Have you noticed? Not one for a while now.
        afterFightPause: 0
        aside: 1
    - rid: 2623126109533504175
      type: {class: WaitForWalkNode, ns: , asm: SafeHaven}
      data:
        id: 948765bbded54ba9b1de3c8d2f44ca01
        position: {x: 2440, y: 1930}
        reaches: 0.9
    - rid: 2623126109533504176
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 2a5433b4991045e3b57d2902d4b3c064
        position: {x: 2740, y: 1760}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 810501267}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: A whole day gone in a morning's walk. I don't like this, and I have liked very few things.
        afterFightPause: 0
        aside: 1
    - rid: 2623126109533504177
      type: {class: WaitForWalkNode, ns: , asm: SafeHaven}
