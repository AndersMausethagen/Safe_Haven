          name: Sigrid
          model: {fileID: 983162859}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Save it for the road. We have until the porridge gets worse.
        afterFightPause: 0
        aside: 1
    - rid: 2623125862064848910
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
