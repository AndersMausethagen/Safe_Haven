    - rid: 2623125860895687609
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 9aca8c14384f475892f950746cd381e3
        position: {x: 1840, y: 1420}
        speaker:
          player: 0
          name: Runa
          model: {fileID: 334759803}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: No birds. Have you noticed? Not one for a while now.
        afterFightPause: 0
        aside: 1
    - rid: 2623125860895687610
      type: {class: WaitForWalkNode, ns: , asm: SafeHaven}
      data:
        id: 65a2ce0d74dc46e6b0c352f001b8fd49
        position: {x: 1540, y: 1760}
        reaches: 0.9
    - rid: 2623125860895687611
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 102445742d48459fa287baa5ae28fbb0
        position: {x: 1840, y: 1590}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 810501267}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: A whole day gone in a morning's walk. I don't like this, and I have liked very few things.
        afterFightPause: 0
        aside: 1
    - rid: 2623125860895687612
