        position: {x: 1540, y: 1420}
        reaches: 0.42
    - rid: 2623125860895687607
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 8b722d64257d4741a5331bc80ee10c3d
        position: {x: 1840, y: 1250}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 810501267}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Sigrid. The sun is going down. It was morning.
        afterFightPause: 0
        aside: 1
    - rid: 2623125860895687608
      type: {class: WaitForWalkNode, ns: , asm: SafeHaven}
      data:
