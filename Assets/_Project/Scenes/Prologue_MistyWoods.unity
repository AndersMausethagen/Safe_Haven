          name: Runa
          model: {fileID: 334759803}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: The shadows are wrong. They were behind us when we crossed the stream.
        afterFightPause: 0
        aside: 1
    - rid: 2623125860895687604
      type: {class: WaitForWalkNode, ns: , asm: SafeHaven}
      data:
        id: 37f367db799446abbc6df26d85e8dde3
