  logSteps: 0
  references:
    version: 2
    RefIds:
    - rid: 2623126109533504255
      type: {class: WhenQuest, ns: , asm: SafeHaven}
      data:
        id: 77173c14c76a41aeb12704da0e6353f9
        position: {x: 40, y: 60}
