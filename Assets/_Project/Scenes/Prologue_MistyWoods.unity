    - rid: 2623126109533504198
      type: {class: ChoiceNode, ns: , asm: SafeHaven}
      data:
        id: f1b108c484d54a8dbd4813fd2a3a6444
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: Sigrid
          model: {fileID: 983162859}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Then one thing first. Nobody walks that road unarmed. We carry spare arms in the packs. They are old and they are plain, but they will do. Take what suits you.
        answers:
        - The sword.
        - The axe.
        - The spear.
        - The club.
        - The bow.
        mustAnswer: 1
        afterFightPause: 1
