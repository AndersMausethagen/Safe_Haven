  sideOffers:
  - quest: {fileID: 11400000, guid: db4bfa3439781c44daaf1680eead8522, type: 2}
    text: 'As it happens. There are blight boar out on the meadow north-east of the camp, which is wrong all by itself, and we could use the meat. Take my spare bow: hold the left button to draw, let go to shoot. Bring down two.'
    acceptText: I'll hunt them.
    waitingText: Two boar, out on the meadow north-east of the camp. Hold the left button to draw.
    askText: Anything I can help with?
    thanksText: Clean enough. Keep the bow; you've earned it, and I was tired of carrying it.
  speakerName: Runa
  portrait: {fileID: 0}
  dialogueCameraDistance: 0.65
