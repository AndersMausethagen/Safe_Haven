    - rid: 287758218191176003
      type: {class: ChoiceNode, ns: , asm: SafeHaven}
      data:
        id: e03c8a2a1e1e472fbfbc5e995ca62abd
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: Sigrid
          model: {fileID: 983162859}
          portrait: {fileID: 0}
        line: 'Before we set out: the cart only had room for two weapons, and you are the one walking in front. The bow keeps them at a distance. The axe keeps them honest. Which will you carry?'
        answers:
        - The bow.
        - The axe.
        mustAnswer: 1
        afterFightPause: 1
    - rid: 287758218191176004
      type: {class: GiveItemsNode, ns: , asm: SafeHaven}
      data:
        id: e3a0ee10e7a0428599795bfa9d4cf356
        position: {x: 1240, y: 60}
