          player: 0
          name: Runa
          model: {fileID: 334759803}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: The shadows are wrong. They were behind us when we crossed the stream.
        afterFightPause: 0
        aside: 1
    - rid: 2623126109533504169
      type: {class: WaitForWalkNode, ns: , asm: SafeHaven}
      data:
        id: 1bd495ac314c4e968b0cf6a67b35d639
