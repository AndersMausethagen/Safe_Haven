          player: 0
          name: Eirik
          model: {fileID: 810501267}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: A bewitched forest. My grandmother called any forest that ate her goats bewitched.
        afterFightPause: 0
        aside: 1
    - rid: 2623125862064848908
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 71854e41d8944bd6b968d2f28db64509
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: Runa
          model: {fileID: 334759803}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Your grandmother never saw wolves walk into a lit camp.
        afterFightPause: 0
        aside: 1
    - rid: 2623125862064848909
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
