        position: {x: 1840, y: 1080}
        speaker:
          player: 0
          name: Sigrid
          model: {fileID: 983162859}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Keep walking.
        afterFightPause: 0
        aside: 1
    - rid: 2623125860895687606
