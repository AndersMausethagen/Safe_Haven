    - rid: 2623126046329274996
      type: {class: WaitNode, ns: , asm: SafeHaven}
      data:
        id: a4947f4e85fd4f5f8b8faeb10b6e6895
        position: {x: 640, y: 60}
        seconds: 0.6
    - rid: 2623126046329274997
      type: {class: ChoiceNode, ns: , asm: SafeHaven}
      data:
        id: 39cfc7eebda7427e9d89176388ec8b82
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: Sigrid
          model: {fileID: 983162859}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Then one thing first. Nobody walks that road unarmed. We carry spare arms in the packs. They are old and they are plain, but they will do. Take what suits you.
        answers:
        - The sword.
        - The axe.
        - The spear.
        - The club.
        - The bow.
        mustAnswer: 1
        afterFightPause: 1
    - rid: 2623126046329274998
      type: {class: GiveItemsNode, ns: , asm: SafeHaven}
