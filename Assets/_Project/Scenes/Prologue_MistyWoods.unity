      data:
        id: 7a0028c53d6145b5ba76103da748777d
        position: {x: 640, y: 60}
        speaker:
          player: 0
          name: Eirik
          model: {fileID: 810501267}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: A bewitched forest. My grandmother called any forest that ate her goats bewitched.
        afterFightPause: 0
        aside: 1
    - rid: 2623126046329275045
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: 8d922d45d81e480fa46f197b46a02cf7
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: Runa
          model: {fileID: 334759803}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Your grandmother never saw wolves walk into a lit camp.
        afterFightPause: 0
        aside: 1
    - rid: 2623126046329275046
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: e4320243a26847edbba06bd7e71790b5
