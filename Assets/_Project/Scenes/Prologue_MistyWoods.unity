          player: 0
          name: Eirik
          model: {fileID: 810501267}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: A bewitched forest. My grandmother called any forest that ate her goats bewitched.
        afterFightPause: 0
        aside: 1
    - rid: 2623126109533504251
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
        id: b780cf1135204ffab5365171ecfd83e8
        position: {x: 940, y: 60}
        speaker:
          player: 0
          name: Runa
          model: {fileID: 334759803}
          portrait: {fileID: 0}
          voice: {fileID: 0}
          voiceFrom: {fileID: 0}
        line: Your grandmother never saw wolves walk into a lit camp.
        afterFightPause: 0
        aside: 1
    - rid: 2623126109533504252
      type: {class: SayNode, ns: , asm: SafeHaven}
      data:
