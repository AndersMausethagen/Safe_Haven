  m_Script: {fileID: 11500000, guid: 761f1ee1822cb4844a3034bb7c1d4011, type: 3}
  m_Name: Eirik
  m_EditorClassIdentifier: SafeHaven::ResidentDefinition
  id: expedition.eirik
  displayName: Eirik
  description: Soldier from the expedition into the Unquiet Forest. Lost when the waystone connection broke.
  portrait: {fileID: 21300000, guid: 226878f3b74cac74f92744bfe07aca7f, type: 3}
  rescueLine: Took you long enough. How many are behind you?
  arrivalLine: Show me the wall. Then show me where it's weakest.
  welcomeLine: Three days I held that clearing. At night something in Granheim mail walked the edge and never came in. I knew the walk. I couldn't give it a name, and I know every man I stood beside.
  fallenLine: Go. I've held worse.
  fightLines:
    spotted:
    - Finally, something I can hit.
    - Stay behind my shield, if you can find it.
    behindYou:
    - Behind you, you fool!
    hurt:
    - Twenty winters, and it still hurts.
    won:
    - Is that all? I was only warming up.
    - Clean your blade. It's a bad habit to forget.
    helpedUp:
    - Ugh. Took your time.
    - Still got one more swing in me, then.
  model: {fileID: 7203023521572123092, guid: e9086faa98b6d46469582090adb9f0e3, type: 3}
  raidCompanion: {fileID: 11400000, guid: 60d284aaf3c06f24fba9e928940c43c5, type: 2}
  memoryLines:
  - kind: 6
    lines:
    - Twenty winters I've been telling that kind of story. First time it's been true.
  - kind: 5
    lines:
    - Don't look at me like that. I was resting. ...Thank you.
  - kind: 3
    lines:
    - My knees are too old to run from a closing portal. Next time leave earlier.
  - kind: 2
    lines:
    - That many, and I'm still here. Don't tell the young ones. They'll want to try it.
  returningLines: []
  talents:
  - skill: {fileID: 11400000, guid: 98481e79d59499846a4c2d233cfe5948, type: 2}
    level: 24
    passion: 2
