  m_Script: {fileID: 11500000, guid: 761f1ee1822cb4844a3034bb7c1d4011, type: 3}
  m_Name: Sigrid
  m_EditorClassIdentifier: SafeHaven::ResidentDefinition
  id: expedition.sigrid
  displayName: Sigrid
  description: Expedition Leader from the expedition into the Unquiet Forest. Lost when the waystone connection broke.
  portrait: {fileID: 21300000, guid: d44ee5592bb9a2c4aa2953eb4fab1ad7, type: 3}
  rescueLine: You came back. I told them you would.
  arrivalLine: Seven went in. Tell me who's home.
  welcomeLine: 
  fallenLine: Don't you stop for me. That's an order.
  fightLines:
    spotted:
    - Stand together! Nobody runs!
    - Form up on me!
    behindYou:
    - Behind you! Move!
    hurt:
    - Still standing. Barely.
    won:
    - Count heads. Everyone still here?
    - Good. Move before more come.
    helpedUp:
    - Good. On your feet. I mean, on mine.
    - Back in line. Thank you.
  model: {fileID: 1441834787134571619, guid: e398fdb177c2d5b4b84f05ca6a27d2cf, type: 3}
  raidCompanion: {fileID: 11400000, guid: 60d284aaf3c06f24fba9e928940c43c5, type: 2}
  memoryLines:
  - kind: 6
    lines:
    - I've buried good people on less than what we just did. Write it down somewhere. It should outlast us.
  - kind: 5
    lines:
    - I gave you an order once to leave me if it came to that. You didn't. We'll talk about discipline. Later.
  - kind: 1
    lines:
    - A retreat is only a defeat if you learn nothing. What did we learn?
  - kind: 4
    lines:
    - I've served under worse than you. Don't let it go to your head.
  returningLines: []
  jobs:
  - {fileID: 11400000, guid: 4c4fcc29299e0dd4b9ba5cfd68e28c5b, type: 2}
