  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 761f1ee1822cb4844a3034bb7c1d4011, type: 3}
  m_Name: Runa
  m_EditorClassIdentifier: SafeHaven::ResidentDefinition
  id: expedition.runa
  displayName: Runa
  description: Tracker from the expedition into the Unquiet Forest. Lost when the waystone connection broke.
  portrait: {fileID: 21300000, guid: 597886e2642f88c4eab3fc52a1e60eb4, type: 3}
  rescueLine: I've watched you for two days. You leave a trail like a cart.
  arrivalLine: This place can be found. Good. So can everything else, by the same road.
  welcomeLine: I found my own marks on the wrong trees. Then I followed your light. A light doesn't move. That's the only reason I'm here.
  fallenLine: I know the way. Go on. I'll catch you up.
  fightLines:
    spotted:
    - There! In the trees!
    - I see them. Take the near ones.
    behindYou:
    - Behind you! Turn around!
    hurt:
    - Too close, too close!
    won:
    - Nothing else on the wind.
    - That's all of them. I think.
    helpedUp:
    - Bow's still good. So am I.
    - Move. I've got your back.
  model: {fileID: 4704275745086199601, guid: eece4adebb5d1a04d820228f6b254479, type: 3}
  raidCompanion: {fileID: 11400000, guid: bfeda7cc0c77ea24dac614548220c4eb, type: 2}
  memoryLines:
  - kind: 6
    lines:
    - I've tracked things my whole life, and never one that big. It left nothing behind but quiet. I don't trust the quiet.
  - kind: 5
    lines:
    - You crossed open ground to reach me. Stupid. Don't stop.
  - kind: 3
    lines:
    - I counted our steps to the exit. I'd rather not count that close again.
  - kind: 1
    lines:
    - The forest doesn't hate us. It doesn't notice us. That's worse. Next time I pick the way.
  returningLines: []
  talents:
  - skill: {fileID: 11400000, guid: cada299a42945b04b8c891d31b0c5351, type: 2}
    level: 24
    passion: 2
  - skill: {fileID: 11400000, guid: c02bc5ecd6589b94daa2ae6d5320cfb6, type: 2}
