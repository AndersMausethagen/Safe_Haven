  m_Name: Runa
  m_EditorClassIdentifier: SafeHaven::ResidentDefinition
  id: expedition.runa
  displayName: Runa
  description: Tracker from the expedition into the Unquiet Forest. Lost when the waystone connection broke.
  rescueLine: I've watched you for two days. You leave a trail like a cart.
  arrivalLine: This place can be found. Good. So can everything else, by the same road.
  welcomeLine: 
  fallenLine: I know the way. Go on. I'll catch you up.
  fightLines:
    spotted:
    - There! In the trees!
    - I see them. Take the near ones.
    behindYou:
    - Behind you! Turn around!
    hurt:
    - Too close, too close!
    won:
    - Nothing else on the wind.
    - That's all of them. I think.
