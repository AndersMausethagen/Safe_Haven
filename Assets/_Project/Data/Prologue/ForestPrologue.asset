  - {fileID: 11400000, guid: 10111c97f83125f4180f05e30f25974d, type: 2}
  - {fileID: 11400000, guid: 7243958d017ac4342ab8fb9df54f8d32, type: 2}
  campfire: {fileID: 11400000, guid: c5579431ac7bb1146b3db512a4783ee8, type: 2}
  buildRadius: 5
  waitingForLeaderText: Speak to Sigrid about the next step.
  dialogueCameraDistance: 0.65
  waveInterval: 25
  firstWaveSize: 3
  waveGrowth: 1
  maximumWaveSize: 7
  maximumEnemies: 14
  wolfPrefab: {fileID: 4509420567327699722, guid: 133e61ca36473ab4999a603e504581a7, type: 3}
  rumble: {fileID: 11400000, guid: 6510718f5af764e4aa78349c4b3f7cdf, type: 2}
  homeScene: SafeHaven
  survivedText: 'Liv: It is open! Sigrid: Everyone, through! Something vast strikes the stones. You reach for the others... and the forest disappears.'
  overwhelmedText: 'Liv: I cannot hold it! Sigrid: Take my hand! A white light tears through the dark...'
  endingStatus: 'THE CONNECTION BREAKS

    A voice calls your name. Then silence.'
  homecomingText: Warmth. Stillness. You wake beneath a living canopy. The others are gone. Nearby, a familiar ring of stones stands dark. Through it, for a moment, you hear Sigrid calling your name.
  recoveryText: Eirik pulls you back into shelter. Try again; your companions are still with you.
  endingSeconds: 3
  recoverySeconds: 2
