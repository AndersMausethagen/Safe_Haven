  - {fileID: 11400000, guid: 7243958d017ac4342ab8fb9df54f8d32, type: 2}
  campfire: {fileID: 11400000, guid: 95f7d6e0cc6f5144fa85269777959d65, type: 2}
  buildRadius: 5
  waitingForLeaderText: Speak to Sigrid about the next step.
  leader: {fileID: 11400000, guid: b230d041259b863428e4e973c6ff0d86, type: 2}
  dialogueCameraDistance: 0.65
  waveInterval: 12
  firstWaveSize: 3
  waveGrowth: 1
  maximumWaveSize: 6
  maximumEnemies: 16
  rumble: {fileID: 11400000, guid: 6510718f5af764e4aa78349c4b3f7cdf, type: 2}
  homeScene: SafeHaven
  survivedText: 'Sigrid: It is open! Everyone, through! The old troll''s fist comes down on the stones. You reach for the others... and the forest disappears.'
  overwhelmedText: 'Sigrid: I cannot hold it! Take my hand! A white light tears through the dark...'
  endingStatus: 'THE CONNECTION BREAKS

    A voice calls your name. Then silence.'
  homecomingText: Warmth. Stillness. You wake beneath a living canopy. The others are gone. Nearby, a familiar ring of stones stands dark. Through it, for a moment, you hear Sigrid calling your name.
  recoveryText: Eirik pulls you back into shelter. Try again; your companions are still with you.
  endingSeconds: 3
  recoverySeconds: 2
