  weight: 1
  earliestSeconds: 40
  latestSecondsLeft: 90
  minimumStage: 0
  warning: 'Blue smoke seeps from a mound among the cedars: a charcoal clamp, and nobody tending it.'
  warningSound: {fileID: 11400000, guid: 53fe372285257d84faf9ea69968a9b0f, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: dd03d601f123f7242baebfa1ee5fe2fd, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: 'The burner left in a hurry: his rake is still in the ash. The clamp is nearly done. Opened too soon, it catches.'
