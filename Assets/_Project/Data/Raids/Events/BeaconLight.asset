  m_Script: {fileID: 11500000, guid: d2f02987ee9197d4682f5db8cbc7a967, type: 3}
  m_Name: BeaconLight
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: BeaconLight
  displayName: Old Beacon
  weight: 1
  earliestSeconds: 60
  latestSecondsLeft: 60
  minimumStage: 0
  warning: 'A faint glow on the slope: an old beacon, still laid with dry wood.'
  warningSound: {fileID: 11400000, guid: 53fe372285257d84faf9ea69968a9b0f, type: 2}
  sitePrefab: {fileID: 7819783059902628876, guid: 03cd33812c655e5469457169b3a9d51d, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: A stone hearth on a bare rise, stacked with dry wood. You can see a long way from here, and a long way off, things can see it.
  artwork: {fileID: 21300000, guid: 1f5bc08810268aa40b0dcf7740f71cd9, type: 3}
  stakes:
    loot: 1
    danger: 1
    time: 1
  onStart: []
  choices:
  - label: Light it
    detail: Shows you the land and every way out. Everything for a long way will come to look.
    cost: []
    requires: []
    result: It goes up with a roar. For a moment the whole forest is laid out in front of you.
    outcomes:
    - rid: 287758281410609281
    - rid: 287758281410609282
  - label: Keep a small fire and rest
    detail: Heals you. Costs you 20 seconds.
    cost: []
    requires: []
    result: You sit with your hands to the warmth until they stop shaking.
    outcomes:
    - rid: 287758281410609283
    - rid: 287758281410609284
  - label: Light it and hold it
    detail: Hold the beacon for 40 seconds while the forest comes to see. Held, it shows the whole land.
    cost: []
    requires: []
    result: The fire takes. Far off, things turn toward the light.
    outcomes:
    - rid: 2623126383268724777
  raisesWhenChosen: {fileID: 0}
