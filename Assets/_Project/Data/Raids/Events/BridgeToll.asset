  m_Script: {fileID: 11500000, guid: d2f02987ee9197d4682f5db8cbc7a967, type: 3}
  m_Name: BridgeToll
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: BridgeToll
  displayName: The Bridge Toll
  weight: 0
  earliestSeconds: 90
  latestSecondsLeft: 90
  minimumStage: 0
  warning: Something sits at the end of the bridge, chin on its fists, and watches you come.
  warningSound: {fileID: 11400000, guid: ad5c451edd0edde49967af502c90ec94, type: 2}
  sitePrefab: {fileID: 3364091344855052720, guid: 129b9139513b1754f98d0d115c6ede3d, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: A troll sits across the end of the bridge. "Toll," it says. "Or riddle. What runs and never walks, has a bed and never sleeps?"
  artwork: {fileID: 21300000, guid: 390f841f37daf3f4c96afdc728c3344d, type: 3}
  onStart: []
  choices:
  - label: Pay in silver
    detail: Three old pennies. It lets you over and tells you what it knows of the valley.
    cost:
    - item: {fileID: 11400000, guid: 3bc6e2e24b1b9d74baa393728cf8b617, type: 2}
      amount: 3
    result: It bites each penny, pockets them somewhere in the moss, and points out every way up the valley.
    outcomes:
    - rid: 287758281410609273
    - rid: 287758281410609274
  - label: Pay in bones
    detail: Three bones. It likes bones better than silver.
    cost:
    - item: {fileID: 11400000, guid: 4f80b5d6098abc64b903316903de5b64, type: 2}
      amount: 3
    result: It crunches them thoughtfully and points out every way up the valley.
    outcomes:
    - rid: 287758281410609273
    - rid: 287758281410609274
  - label: '"A river."'
    detail: An answer.
    cost: []
    result: It laughs until moss falls off it, and tosses you something from its pile.
    outcomes:
    - rid: 287758281410609275
  - label: '"The wind."'
    detail: An answer.
    cost: []
    result: '"No," it says, and stands up.'
    outcomes:
    - rid: 287758281410609276
    - rid: 287758281410609277
  - label: Walk through it
    detail: It won't move. Its children might.
    cost: []
    result: It whistles through its teeth, and the rocks around you get up.
    outcomes:
    - rid: 287758281410609278
    - rid: 287758281410609279
