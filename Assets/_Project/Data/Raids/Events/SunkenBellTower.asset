  m_Name: SunkenBellTower
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: SunkenBellTower
  displayName: The Sunken Bell Tower
  weight: 1
  earliestSeconds: 60
  latestSecondsLeft: 100
  minimumStage: 0
  warning: Under the water a bell rings, slow and deep. Out in the fen, a belfry leans out of the mud.
  warningSound: {fileID: 11400000, guid: 4cc9bc40fb223354aa6032cf0c7fb0f2, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: 78926bf6c389faf45858997193599ac6, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: A church's belfry, sunk to its eaves in the bog, its bell still hanging. The water round it is too black to see into, and something below keeps time with the bell.
  artwork: {fileID: 21300000, guid: cff23f134d9051d4cb25298777d3a45c, type: 3}
  stakes:
    loot: 2
    danger: 2
    time: 1
  onStart: []
  choices:
  - label: Ring it from the belfry
    detail: Hold the belfry for 35 seconds while the drowned climb out to see who rang.
    cost: []
    requires: []
    result: You haul the rope. The note goes down into the water, and the water stirs.
    outcomes:
    - rid: 2623126383268724754
  - label: Dive the stair
    detail: 'Only after dark is the water clear enough to find the stair. Cold: a sixth of your health and 30 seconds.'
    cost: []
    requires:
    - rid: 2623126383268724760
    result: You go down the drowned stair into the black.
    outcomes:
    - rid: 2623126383268724761
    - rid: 2623126383268724762
    - rid: 2623126383268724763
  - label: Listen to the bell
    detail: Free. Let it ring.
    cost: []
    requires: []
    result: You stand still and let it ring.
    outcomes:
    - rid: 2623126383268724764
    - rid: 2623126383268724765
