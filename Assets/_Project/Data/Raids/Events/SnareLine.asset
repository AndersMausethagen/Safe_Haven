  id: SnareLine
  displayName: The Snare Line
  weight: 1
  earliestSeconds: 60
  latestSecondsLeft: 100
  minimumStage: 0
  warning: Something big thrashes in a snare not far off, then goes quiet.
  warningSound: {fileID: 11400000, guid: 4cc9bc40fb223354aa6032cf0c7fb0f2, type: 2}
