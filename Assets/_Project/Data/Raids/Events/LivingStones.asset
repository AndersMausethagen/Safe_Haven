  id: LivingStones
  displayName: The Living Path
  weight: 0.9
  earliestSeconds: 60
  latestSecondsLeft: 110
  minimumStage: 0
  warning: Close by, stone grinds on stone. The runestones are moving.
  warningSound: {fileID: 11400000, guid: ad5c451edd0edde49967af502c90ec94, type: 2}
  sitePrefab: {fileID: 1745827551758765297, guid: c3220598a4d922b4cb9f391a54f9ebd3, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: 'Three runestones stand where the path should be. One is green with fresh moss. One is warm to the touch. One is scored with claw marks. Old rhyme: "Moss grows slow, so moss won''t lie."'
  onStart: []
  choices:
  - label: Follow the mossy stone
    detail: It hasn't moved in a long time.
    cost: []
    result: The path opens, and it leads somewhere shorter than it should.
    outcomes:
    - rid: 287758281410609285
    - rid: 287758281410609286
  - label: Follow the warm stone
    detail: Something is under it. Could be good.
    cost: []
    result: You put your shoulder to it.
    outcomes:
    - rid: 287758281410609287
  - label: Follow the clawed stone
    detail: Something else went this way.
    cost: []
    result: The path closes behind you, and the cold comes up out of the ground.
    outcomes:
    - rid: 287758281410609292
    - rid: 287758281410609293
