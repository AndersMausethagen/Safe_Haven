  m_Name: EldersBell
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: EldersBell
  displayName: The Elder's Bell
  weight: 1
  earliestSeconds: 60
  latestSecondsLeft: 100
  minimumStage: 0
  warning: A bell rings once in the deep wood, though there is no wind.
  warningSound: {fileID: 11400000, guid: 53fe372285257d84faf9ea69968a9b0f, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: 99547257fa29eb64da45a89868659a62, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: An oak older than the forest round it. Bells hang from its last branch, green with age, and the roots at its foot are not still.
  artwork: {fileID: 21300000, guid: 373a41dc7b8fceb4385f5bf65ae76a03, type: 3}
  stakes:
    loot: 2
    danger: 2
    time: 1
  onStart: []
  choices:
  - label: Ring the bell and hold the oak
    detail: Hold the oak for 40 seconds while the roots wake. The Elder pays those who stand.
    cost: []
    requires: []
    result: The bell's note runs down into the roots, and the roots answer.
    outcomes:
    - rid: 2623126383268724736
  - label: Climb up quietly
    detail: Take the offerings tied in its branches without waking anything.
    cost: []
    requires:
    - rid: 2623126383268724741
    result: 'Silver, a carved stone, a pot of honey: what the woodfolk gave the Elder.'
    outcomes:
    - rid: 2623126383268724742
  - label: Lay a hand on the bark
    detail: Nothing taken, nothing asked.
    cost: []
    requires: []
    result: You stand a moment with your palm on the old wood.
    outcomes:
    - rid: 2623126383268724743
  raisesWhenChosen: {fileID: 0}
