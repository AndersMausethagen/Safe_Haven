  m_Name: TrappedPedlar
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: TrappedPedlar
  displayName: Cries from the Ditch
  weight: 1
  earliestSeconds: 40
  latestSecondsLeft: 90
  minimumStage: 0
  warning: Someone is shouting for help, off the path.
  warningSound: {fileID: 11400000, guid: 53fe372285257d84faf9ea69968a9b0f, type: 2}
  sitePrefab: {fileID: 8216466046246968194, guid: c01d4d922b5f33041ba5c004979e6d57, type: 3}
  siteDistance: {x: 35, y: 70}
  nearWater: 0
  siteText: A pedlar lies pinned under a fallen spruce, his pack just out of his reach. "Please. They'll smell me soon."
  artwork: {fileID: 21300000, guid: 28e3fb90cff3ffa499b1fb7a6e27529f, type: 3}
  stakes:
    loot: 1
    danger: 1
    time: 1
  onStart: []
  choices:
  - label: Lift the log
    detail: Costs you 45 seconds, and it's loud work.
    cost: []
    requires: []
    hiddenUntilMet: 0
    result: He limps off into the trees, but not before pressing his purse into your hand.
    outcomes:
    - rid: 287758281410609252
    - rid: 287758281410609253
    - rid: 287758281410609254
    - rid: 2623126385950982144
  - label: Take his pack and go
    detail: Quick. You'll carry it with you for a while.
    cost: []
    requires: []
    hiddenUntilMet: 0
    result: You don't look back. His voice follows you for a long time.
    outcomes:
    - rid: 287758281410609255
    - rid: 287758281410609256
    - rid: 2623126385950982146
  - label: Lever the log off
    detail: 'A woodsman knows where to push: 15 seconds, and quiet.'
    cost: []
    requires:
    - rid: 2623126383268724766
    hiddenUntilMet: 0
    result: One good heave in the right place and the log rolls. He presses his purse into your hand.
    outcomes:
    - rid: 2623126383268724767
    - rid: 2623126383268724768
    - rid: 2623126385950982145
