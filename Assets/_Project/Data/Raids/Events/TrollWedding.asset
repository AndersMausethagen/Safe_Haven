  minimumStage: 0
  warning: Drums at dusk from the stones up the valley, and singing, if you can call it that.
  warningSound: {fileID: 11400000, guid: ad5c451edd0edde49967af502c90ec94, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: 11ffd51ad4390f1449181f5337bd653a, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: Two clans of trolls at the ring of stones, and a bride in a crown of rough trollstone. Nobody has seen you yet.
