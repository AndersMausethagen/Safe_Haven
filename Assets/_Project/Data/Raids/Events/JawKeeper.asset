  m_Script: {fileID: 11500000, guid: d2f02987ee9197d4682f5db8cbc7a967, type: 3}
  m_Name: JawKeeper
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: JawKeeper
  displayName: The Jaw-keeper
  weight: 1
  earliestSeconds: 90
  latestSecondsLeft: 90
  minimumStage: 0
  warning: Stone grinds on stone ahead, slow, like something chewing.
  warningSound: {fileID: 11400000, guid: ad5c451edd0edde49967af502c90ec94, type: 2}
  sitePrefab: {fileID: 6647756069553415008, guid: f84594aad344c594abcb806f91dfb737, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: Something of stone and antler sits across the way, older than the trolls, its jaw resting on its knees. "Everyone pays the Jaw-keeper," it says. "Iron, or a memory. Or try to pass, and see what the valley thinks of you."
  artwork: {fileID: 21300000, guid: 390f841f37daf3f4c96afdc728c3344d, type: 3}
  stakes:
    loot: 0
    danger: 0
    time: 1
  onStart: []
  choices:
  - label: Pay in iron
    detail: Five iron ore from your bag.
    cost:
    - item: {fileID: 11400000, guid: ec438ce757d5e9e43bbd93390e7a2728, type: 2}
      amount: 5
    requires: []
    result: It takes the ore in one stone hand and crushes it like bread. "The way is yours," it says, and shows you all of it.
    outcomes:
    - rid: 2623126268168110234
  - label: Pay with a memory
    detail: Something you would rather keep. It costs time to find what it wants.
    cost: []
    requires: []
    result: It reaches into your thoughts and takes a morning you liked. You stand blinking while the light moves. "Fair," it says, and something of its own goes into your pack.
    outcomes:
    - rid: 2623126268168110235
    - rid: 2623126268168110236
  - label: Walk past it
    detail: It won't stop you. The valley might.
    cost: []
    requires: []
    result: It does not move. The rocks round it do.
    outcomes:
    - rid: 2623126268168110237
    - rid: 2623126268168110238
  raisesWhenChosen: {fileID: 0}
