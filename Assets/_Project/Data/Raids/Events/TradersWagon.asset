  m_Script: {fileID: 11500000, guid: d2f02987ee9197d4682f5db8cbc7a967, type: 3}
  m_Name: TradersWagon
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: TradersWagon
  displayName: Overturned Wagon
  weight: 1.2
  earliestSeconds: 40
  latestSecondsLeft: 90
  minimumStage: 0
  warning: A broken wheel and scattered parcels on an old track. Someone left in a hurry.
  warningSound: {fileID: 11400000, guid: 53fe372285257d84faf9ea69968a9b0f, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: bd8a1f03c8c250c41ae841b63b5f8ead, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: A trader's wagon on its side, one wheel in splinters. Parcels lie in the mud. Claw marks on the boards, not old.
  artwork: {fileID: 21300000, guid: 900ca9dc08a62944d9b2c090d3388351, type: 3}
  stakes:
    loot: 2
    danger: 1
    time: 1
  onStart: []
  choices:
  - label: Search it carefully
    detail: Costs you 30 seconds. Quiet.
    cost: []
    requires: []
    result: You go through it parcel by parcel.
    outcomes:
    - rid: 287758281410609264
    - rid: 287758281410609265
  - label: Grab what you can
    detail: Fast and loud. Whatever did this may still be close.
    cost: []
    requires: []
    result: You tear it open and stuff your pack.
    outcomes:
    - rid: 287758281410609266
    - rid: 287758281410609267
    - rid: 287758281410609268
  - label: Mend the wheel
    detail: The trader hides close by. Fair traders pay fairly.
    cost:
    - item: {fileID: 11400000, guid: a370187223419a048b6cebe8f7e345a3, type: 2}
      amount: 2
    - item: {fileID: 11400000, guid: 4df650debd4ce21459e04a0c92ffa207, type: 2}
      amount: 1
    requires: []
    result: A thin man comes out of the ferns, thanks you three times and tells you the safe way.
    outcomes:
    - rid: 287758281410609271
    - rid: 287758281410609272
  - label: Mend it like a builder
    detail: One plank and a builder's knack, where others need two and cord.
    cost:
    - item: {fileID: 11400000, guid: a370187223419a048b6cebe8f7e345a3, type: 2}
      amount: 1
    requires:
    - rid: 2623126383268724772
    result: The wheel's on in a moment. The trader comes out of the ferns and tells you the safe way.
    outcomes:
    - rid: 2623126383268724773
    - rid: 2623126383268724774
