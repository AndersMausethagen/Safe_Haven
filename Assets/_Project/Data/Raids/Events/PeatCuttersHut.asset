  m_Name: PeatCuttersHut
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: PeatCuttersHut
  displayName: The Peat Cutter's Hut
  weight: 1
  earliestSeconds: 40
  latestSecondsLeft: 90
  minimumStage: 0
  warning: A thread of peat smoke rises from a hut half sunk in the moss.
  warningSound: {fileID: 11400000, guid: 53fe372285257d84faf9ea69968a9b0f, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: 5ced1626648963141b376956f25948c8, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: 'Nobody is home, but the stove is still warm and the kettle full. On the shelf: bog iron, a pouch of myrtle, a peat cutter''s tools.'
  artwork: {fileID: 21300000, guid: cc658c6a7efc7964d839d12c39544079, type: 3}
  onStart: []
  choices:
  - label: Rest by the stove
    detail: Costs 30 seconds. Dry boots, warm hands.
    cost: []
    result: You sit until your hands stop shaking.
    outcomes:
    - rid: 2623126381840826401
    - rid: 2623126381840826402
  - label: Search the shelves
    detail: Quick. Whoever lives here may not like it.
    cost: []
    result: 'Bog iron, charcoal, myrtle: a peat cutter''s wealth.'
    outcomes:
    - rid: 2623126381840826403
    - rid: 2623126381840826404
  - label: Leave two pennies
    detail: Pay for what you take, and whoever lives here has no quarrel with you.
    cost:
    - item: {fileID: 11400000, guid: 3bc6e2e24b1b9d74baa393728cf8b617, type: 2}
      amount: 2
    result: You leave the coins by the kettle. The smoke seems to bend toward you.
    outcomes:
    - rid: 2623126381840826407
