  siteDistance: {x: 35, y: 70}
  nearWater: 0
  siteText: The herders are long gone, but their lur still hangs on the gatepost, wrapped in birch bark. Blown hard, it carries across the whole valley.
  artwork: {fileID: 21300000, guid: 1376e2bc405186941ace0a85e714835d, type: 3}
