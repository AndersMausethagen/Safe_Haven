  m_Name: WoodcuttersLastTree
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: WoodcuttersLastTree
  displayName: The Woodcutter's Last Tree
  weight: 1
  earliestSeconds: 60
  latestSecondsLeft: 90
  minimumStage: 0
  warning: Somewhere close, an axe stopped mid-stroke. It hasn't started again.
  warningSound: {fileID: 11400000, guid: 4cc9bc40fb223354aa6032cf0c7fb0f2, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: 09b63056c186bff4ba9fa6dacbe2c534, type: 3}
  siteDistance: {x: 35, y: 70}
  nearWater: 0
  siteText: A giant cedar, cut halfway through. The axe is still in it; the woodcutter isn't. Wolf tracks circle the stump, and below the bank a den stinks of old meat.
  artwork: {fileID: 21300000, guid: 731b8679cab6b5047a701cce33f24fd9, type: 3}
  stakes:
    loot: 2
    danger: 1
    time: 1
  onStart: []
  choices:
  - label: Fell it onto the den
    detail: It crushes the wolves' den, and what they dragged in spills out. 20 seconds.
    cost: []
    requires:
    - rid: 2623126389041660013
    hiddenUntilMet: 0
    result: Three blows, a crack like thunder, and the cedar comes down across the den.
    outcomes:
    - rid: 2623126389041660014
    - rid: 2623126389041660015
    - rid: 2623126389041660016
    - rid: 2623126389041660017
  - label: Fell it for the timber
    detail: 'Good wood, but loud: the wolves come to see. 30 seconds.'
    cost: []
    requires: []
    hiddenUntilMet: 0
    result: It comes down slow and huge. Something howls.
    outcomes:
    - rid: 2623126389041660018
    - rid: 2623126389041660019
    - rid: 2623126389041660020
    - rid: 2623126389041660021
  - label: Take the axe and go
    detail: Free. It's still sharp.
    cost: []
    requires: []
    hiddenUntilMet: 0
    result: You work it loose. The tree creaks, and holds.
    outcomes:
    - rid: 2623126389041660022
