  m_Name: StoneHead
  m_EditorClassIdentifier: SafeHaven::RaidEventDefinition
  id: StoneHead
  displayName: The Stone Head
  weight: 1
  earliestSeconds: 40
  latestSecondsLeft: 150
  minimumStage: 0
  warning: On the scree above the path, something the size of a barrel caught the dawn and never moved again.
  warningSound: {fileID: 11400000, guid: ad5c451edd0edde49967af502c90ec94, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: fa1c80b570c2e0c4aab82ed80af86aaf, type: 3}
  siteDistance: {x: 35, y: 70}
  siteText: A troll's head, turned to stone at sunrise and rolled down the scree. Heavy, but not too heavy for a determined back, and worth a great deal at home.
  artwork: {fileID: 21300000, guid: 667b9f0189e11224f98c04c558542aa1, type: 3}
  stakes:
    loot: 2
    danger: 1
    time: 2
  onStart: []
  choices:
  - label: Carry it out
    detail: Slow, loud and worth a great deal at home. Strike, dodge or guard and you set it down; pick it up again after.
    cost: []
    requires: []
    result: You get your arms round it and lift. Your knees argue.
    outcomes:
    - rid: 2623126383268724747
  - label: Break it open
    detail: Costs 25 seconds of loud work with a pickaxe.
    cost: []
    requires:
    - rid: 2623126383268724749
    result: It splits along an old crack.
    outcomes:
    - rid: 2623126383268724750
    - rid: 2623126383268724751
    - rid: 2623126383268724752
  - label: Leave it grinning
    detail: Nothing for it here.
    cost: []
    requires: []
    result: You leave it on the scree.
    outcomes:
    - rid: 2623126383268724753
