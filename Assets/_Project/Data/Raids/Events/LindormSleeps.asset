  id: LindormSleeps
  displayName: The Lindorm Sleeps
  weight: 0.15
  earliestSeconds: 120
  latestSecondsLeft: 150
  minimumStage: 0
  warning: The ground ahead rises and falls, slow as breathing.
  warningSound: {fileID: 11400000, guid: 4cc9bc40fb223354aa6032cf0c7fb0f2, type: 2}
  sitePrefab: {fileID: 7940016432191105948, guid: d036618c37fe2194eb629bf220831bef, type: 3}
  siteDistance: {x: 35, y: 70}
  nearWater: 0
  siteText: The lindorm's back, arch after arch of it, out of the black water. Beyond, on an islet, something glints. It's asleep.
  artwork: {fileID: 21300000, guid: 461dc144cac014a4faa54dd9134aff8b, type: 3}
  stakes:
    loot: 2
    danger: 2
    time: 2
  onStart: []
  choices:
  - label: Walk its back to the islet
    detail: Costs 45 seconds. Don't wake it.
    cost: []
    requires: []
    hiddenUntilMet: 0
    result: You step from coil to coil.
    outcomes:
    - rid: 2623126385950982196
    - rid: 2623126385950982197
  - label: Take a shed scale
    detail: One lies loose in the moss.
    cost: []
    requires: []
    hiddenUntilMet: 0
    result: It's as big as a shield and lighter than it looks.
    outcomes:
    - rid: 2623126385950982204
  - label: Leave it sleeping
    detail: Some things are best not woken.
    cost: []
    requires: []
    hiddenUntilMet: 0
    result: You go round, a long way round.
    outcomes:
    - rid: 2623126385950982205
