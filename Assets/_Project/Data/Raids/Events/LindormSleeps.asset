  blockedByMark: 
  oncePerSave: 1
  moreLikelyWhen: []
  moreLikelyWithMark:
  - mark: event:lindorm:heard
    times: 4
  legendPage: The Lindorm sleeps in the Moss Marsh, coiled through the black water with moss in the joins of its scales. It breathes once a minute. It has not woken. Yet.
