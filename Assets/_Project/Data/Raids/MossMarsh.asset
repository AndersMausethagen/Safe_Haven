  m_Name: MossMarsh
  m_EditorClassIdentifier: Assembly-CSharp::RaidDefinition
  id: moss_marsh
  displayName: Moss Marsh
  description: A wide high moor of black pools and red moss under an open sky, where the old road sinks into the Drowning Fen. Something in the water keeps what it takes.
  land: fen
  tier: 3
  sceneName: Raid_MossMarsh
  locked: 1
  unlockedBy: {fileID: 11400000, guid: 9270117f6be16f544877dc59efdbc8e4, type: 2}
  largeRaid:
    widthScale: 2
    extraSeconds: 750
    extraExits:
    - Rockfall Gap
    - Goat Stair
    - Cold Ford
  lockedText: The road to the Moss Marsh runs over Troll Valley's last bridge, and the Brukam sits on it.
  encounter: {fileID: 0}
  knownEnemies:
  - {fileID: 11400000, guid: 6a0d0fdf47eac744da300d2daa665816, type: 2}
