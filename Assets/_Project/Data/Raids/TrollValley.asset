  m_Script: {fileID: 11500000, guid: c72e5e4fd746250409a431420bdc103e, type: 3}
  m_Name: TrollValley
  m_EditorClassIdentifier: Assembly-CSharp::RaidDefinition
  id: troll_valley
  displayName: Troll Valley
  description: A long valley of old stone bridges where the trolls still take their tolls. Trolls of every size live here, and at its deepest Trollstone is to be had.
  land: valley
  tier: 2
  sceneName: Raid_TrollValley
  locked: 1
  unlockedBy: {fileID: 11400000, guid: 9b7313d497a67e54b8b12e51990184bb, type: 2}
  largeRaid:
    widthScale: 2
    extraSeconds: 750
    extraExits:
    - Rockfall Gap
    - Goat Stair
    - Cold Ford
  lockedText: The way to Troll Valley lies beyond the Misty Woods. Something old in the deep woods holds it shut.
  encounter: {fileID: 0}
  knownEnemies:
  - {fileID: 11400000, guid: 1fc74e15f41da234fb9eeedcfe1067f0, type: 2}
  - {fileID: 11400000, guid: 115647db9b5ff0f46bc496b0532bbcec, type: 2}
