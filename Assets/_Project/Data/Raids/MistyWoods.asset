  m_Name: MistyWoods
  m_EditorClassIdentifier: Assembly-CSharp::RaidDefinition
  id: wildlands
  displayName: Misty Woods
  description: The nearest wild forest beyond the portal, where mist hangs between old pines. Cursed things hunt here, and what lies deeper grows worse the harder you go.
  land: forest
  tier: 1
  sceneName: Raid_MistyWoods
  locked: 0
  unlockedBy: {fileID: 0}
