  m_Script: {fileID: 11500000, guid: d2462b67111854f46a3ada8872bdc8f6, type: 3}
  m_Name: Boss The Heartroot
  m_EditorClassIdentifier: SafeHaven::BossDefinition
  id: boss_heartroot
  displayName: The Heartroot
  title: Guardian of the Hollow
  phases:
  - belowHealth: 0.66
    line: The ground shakes. Roots begin to tear free.
    reelSeconds: 1.8
    damageBonus: 0.1
    glow: {r: 0.275, g: 1.32, b: 0.22000001, a: 1}
    sound: {fileID: 11400000, guid: 7a7933cc7f7f0ad4aaf1e1190ea7248a, type: 2}
  - belowHealth: 0.33
    line: The old heart splits, and what is in it is angry.
    reelSeconds: 2.2
    damageBonus: 0.2
    glow: {r: 0.55, g: 2.64, b: 0.44000003, a: 1}
    sound: {fileID: 11400000, guid: 7a7933cc7f7f0ad4aaf1e1190ea7248a, type: 2}
  rewardSkill: {fileID: 11400000, guid: ea2ebfef3d35eae42a29237e4b273b5d, type: 2}
  defeatLine: 'The Heartroot sinks to its knees, and speaks once, in a voice like the portal''s own: "Hearth-keeper." Then it lies still. What it knew of the forest''s hold is yours now: you have learned Heartroot''s Grasp. And something has opened: the portal can reach Troll Valley.'
  wakeSeconds: 3.2
  wakeSound: {fileID: 11400000, guid: 117e6f9038657034bbb7373e39bbd293, type: 2}
  music:
    tracks:
    - clip: {fileID: 8300000, guid: a42d8fa1e22662d4d83591c4bdfb0f30, type: 3}
      volume: 0
      startAt: 0
    order: 0
  trophy: {fileID: 4208037901244437991, guid: ab8e47ca6036d17419c93050c9a123a9, type: 3}
  homeLines:
  - They say it's dead. The Heartroot. I felt the ground go quiet, and I don't know if I like it quiet.
  - You killed it? Truly? Then what else is out there that we were told couldn't be?
  - I'd have said nobody could. I'll say it about something else next time, and you can prove me wrong again.
  - Whatever you carried back from that hollow, the portal wants it by the fire. I'd never have thought it.
