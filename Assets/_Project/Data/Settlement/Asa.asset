  m_Script: {fileID: 11500000, guid: 761f1ee1822cb4844a3034bb7c1d4011, type: 3}
  m_Name: Asa
  m_EditorClassIdentifier: SafeHaven::ResidentDefinition
  id: settler.asa
  displayName: Asa
  description: A farmer from a village that isn't there any more. She brought the seed, and little else.
  portrait: {fileID: 21300000, guid: 00080c620758e334298ab876619b788e, type: 3}
  rescueLine: You're not from the village. Doesn't matter. Help me with this sack.
  arrivalLine: There's good dirt under all this moss. Who's been using it?
  welcomeLine: I'm from past the ridge. I walked home last spring and the road went somewhere else, and my village wasn't at the end of it.
  fallenLine: I can't go on... come back for me.
