  m_Script: {fileID: 11500000, guid: 761f1ee1822cb4844a3034bb7c1d4011, type: 3}
  m_Name: Gunnar
  m_EditorClassIdentifier: SafeHaven::ResidentDefinition
  id: settler.gunnar
  displayName: Gunnar
  description: A hunter who has been walking these woods for years, alone by choice, until the choice ran out.
  portrait: {fileID: 21300000, guid: e7660c02df638bc46bcd176886f9751e, type: 3}
  rescueLine: Took you long enough. That boar's been lying on me since yesterday.
  arrivalLine: You've been frightening my deer. Least you can do is give me a roof.
  welcomeLine: Twenty years I never lost a path in these woods. This year the paths started moving. Then the deer stopped running from me and started running from something else.
  fallenLine: I can't go on... come back for me.
  fightLines:
    spotted: []
    behindYou: []
    hurt: []
    won: []
    helpedUp: []
  model: {fileID: 4545198816639002052, guid: d1bff4db31900154b9550b8dd8a37606, type: 3}
  raidCompanion: {fileID: 11400000, guid: 60d284aaf3c06f24fba9e928940c43c5, type: 2}
  memoryLines: []
  returningLines: []
  jobs:
  - {fileID: 11400000, guid: 9d8e9d72cc07d544c975b891d5c740e6, type: 2}
  - {fileID: 11400000, guid: e9647a52d2bdeec478f332bf63b64731, type: 2}
  questLine:
  - quest: {fileID: 11400000, guid: a2c8684a2832f0c43b9d3c55f3682754, type: 2}
    text: Boars come to the edge of the light at dusk. Bring me their hides and give me a lodge to cure them in, and you'll have leather that turns a tooth.
    acceptText: Hides and a lodge.
    waitingText: Four rough hides from the boars outside the light, and a Hunter's Lodge.
    askText: 
    thanksText: 
  - quest: {fileID: 11400000, guid: bcfcd3deb7d403642871b260752b6eae, type: 2}
    text: A raw hide rots. Cure four at the lodge and you'll see why the old hunters lived longer than the brave ones.
    acceptText: Four, cured.
    waitingText: Cure four leathers at the Hunter's Lodge.
    askText: 
    thanksText: 
  - quest: {fileID: 11400000, guid: 8c87695da6d1abb40bbe4e4d4e6ea378, type: 2}
    text: There's still water by the Haven. Fish it, if you like. Build a dock first, and don't say the name of the thing in the deep. It listens.
    acceptText: A dock. No names.
    waitingText: A Dock on the still water, and one fish from it.
    askText: 
    thanksText: 
  - quest: {fileID: 11400000, guid: 039aaf379d25f0f4a8ec97eed60f5a83, type: 2}
    text: 'My grandmother said you hold a nykk with its own hair and steel in the water. Its hair makes a line the deep fish can''t leave alone. The reeds in the Moss Marsh: it combs itself there. Two hairs. Don''t say its name.'
    acceptText: Two hairs, and no names.
    waitingText: Two of its pale hairs from the Moss Marsh reeds, and the Dock at Tier II.
    askText: 
    thanksText: 
  questLineDone: 
