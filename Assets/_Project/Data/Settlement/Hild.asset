  jobs:
  - {fileID: 11400000, guid: 59a0d6a12e809f84f92d2b2a418d1d26, type: 2}
  questLine:
  - quest: {fileID: 11400000, guid: a27b02dff679e08448ddebf15ec9fa94, type: 2}
    text: Wood burns. Stone remembers. Give me the Mason's work and a better workshop, and I'll show you a cottage with a proper hearth.
    acceptText: Stone, then.
    waitingText: Bjarne's Smithy standing, the Workshop at Tier II, then a Cottage.
    askText: 
    thanksText: 
  - quest: {fileID: 11400000, guid: e849154c379290b49953300c228f2b24, type: 2}
    text: Palisades burn. Granite doesn't. Raise the workshop again, cut four blocks, and put up four lengths of stone wall.
    acceptText: Walls that don't burn.
    waitingText: The Workshop at Tier III, four Granite Blocks, and four lengths of Stone Wall.
    askText: 
    thanksText: 
  questLineDone: 
